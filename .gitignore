# 1. Environment & Secrets (NEVER COMMIT)
.env
.env.*
.dev.vars
!.env.example
deploy/.env.example
core/.env.example
team_tasks/
team_task/
graphify-out/
.claude/
CyberProof_ET_Concept_Note_BiT.docx
TEAM_ROLES_AND_5MIN_DEMO_MASTER_GUIDE.md
# 2. Python & Virtual Environments
**/venv/
**/.venv/
**/env/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# 3. Node, Bun & JavaScript Build Outputs
**/node_modules/
**/.output/
**/.nitro/
**/.tanstack/
**/.vinxi/
**/dist/
**/dist-ssr/
**/.wrangler/
**/.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. Git Backups & Temporary Stores
**/.git.backup/
**/.git.bak/
*.orig

# 5. OS & Editor Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Logs & Runtime Dumps
logs/
*.log
uv.lock
